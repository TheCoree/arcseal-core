# --- DB ---
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=arcseal_db

# Use postgresql+asyncpg for async connection
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# --- JWT & Security ---
SECRET_KEY=some_very_long_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- CORS ---
# Must be a valid JSON-parsed array of strings
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# --- Refresh cookie ---
# In dev (plain HTTP) keep COOKIE_SECURE=False so the browser sends the cookie back.
# Use COOKIE_SAMESITE=lax when frontend and backend share the same hostname
# (e.g. both on "localhost"). For HTTPS production set COOKIE_SECURE=True.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
